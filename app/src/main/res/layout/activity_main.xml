<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cardLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/logo"
        android:scaleType="centerCrop"
        android:contentDescription="Logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="200dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kopi dan Nyemil"
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="@id/cardLogo"
        app:layout_constraintStart_toStartOf="@id/cardLogo"
        app:layout_constraintTop_toTopOf="@id/cardLogo"
        android:layout_marginTop="187dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Get a taste of your wish"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/cardLogo"
        app:layout_constraintStart_toStartOf="@id/cardLogo"
        app:layout_constraintTop_toTopOf="@id/cardLogo"
        android:layout_marginTop="255dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartnow"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:text="Start now"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:elevation="4dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="70dp" />

</androidx.constraintlayout.widget.ConstraintLayout>