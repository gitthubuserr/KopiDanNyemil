<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvHalo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="35sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="35dp" />

    <TextView
        android:id="@+id/tvProfileSaya"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Saya"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="@id/tvHalo"
        app:layout_constraintTop_toTopOf="@id/tvHalo"
        android:layout_marginTop="50dp"
        android:layout_marginStart="0dp" />

    <TextView
        android:id="@+id/tvProfileSetting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Setting"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvProfileSaya"
        app:layout_constraintTop_toTopOf="@id/tvProfileSaya"
        android:layout_marginTop="30dp"
        android:layout_marginStart="0dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilName"
        android:layout_width="350dp"
        android:layout_height="65dp"
        android:hint="nama"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="#FFFFFF"
        app:boxStrokeColor="#000000"
        app:boxStrokeWidth="2dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="15dp"
        app:boxCornerRadiusTopEnd="15dp"
        app:boxCornerRadiusBottomStart="15dp"
        app:boxCornerRadiusBottomEnd="15dp"
        app:layout_constraintTop_toBottomOf="@id/tvHalo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="textPersonName"
            android:textColor="#000000"
            android:textSize="16sp"
            android:padding="15dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHome"
        android:layout_width="116dp"
        android:layout_height="70dp"
        android:text="Home"
        android:textColor="#C5C5C5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF"
        android:elevation="4dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/btnOrder"
        android:layout_marginBottom="45dp"
        android:layout_marginEnd="100dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOrder"
        android:layout_width="116dp"
        android:layout_height="70dp"
        android:text="Order"
        android:textColor="#C5C5C5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#FFFFFF"
        android:elevation="4dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="45dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfile"
        android:layout_width="116dp"
        android:layout_height="70dp"
        android:text="Profile"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:elevation="4dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/btnOrder"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="45dp"
        android:layout_marginStart="100dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="350dp"
        android:layout_height="70dp"
        android:text="Save"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#000000"
        android:elevation="4dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="@id/btnOrder"
        app:layout_constraintStart_toStartOf="@id/btnOrder"
        app:layout_constraintEnd_toEndOf="@id/btnOrder"
        android:layout_marginBottom="70dp" />


</androidx.constraintlayout.widget.ConstraintLayout>